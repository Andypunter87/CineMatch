rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Core User Data Protection (Primary Structure) ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User subcollections - secured to user
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // --- Legacy Collections (Current App Structure) ---
    // Allow authenticated users to access their own data in legacy format
    match /user_preferences/{documentId} {
      allow read, write: if request.auth != null && 
        (documentId.matches('user-.*') && documentId.split('user-')[1] == request.auth.uid);
    }
    
    match /onboarding_ratings/{documentId} {
      allow read, write: if request.auth != null && 
        ((resource != null && resource.data.userId == request.auth.uid) || 
         (request.resource != null && request.resource.data.userId == request.auth.uid));
    }
    
    match /recommendation_ratings/{documentId} {
      allow read, write: if request.auth != null && 
        ((resource != null && resource.data.userId == request.auth.uid) || 
         (request.resource != null && request.resource.data.userId == request.auth.uid));
    }
    
    match /watchlist/{documentId} {
      allow read, write: if request.auth != null && 
        ((resource != null && resource.data.userId == request.auth.uid) || 
         (request.resource != null && request.resource.data.userId == request.auth.uid));
    }
    
    match /friends/{documentId} {
      allow read, write: if request.auth != null && 
        ((resource != null && resource.data.userId == request.auth.uid) || 
         (request.resource != null && request.resource.data.userId == request.auth.uid));
    }
    
    // --- Shared Features ---
    match /shared_recommendations/{sessionId} {
      allow read, write: if request.auth != null && 
        ((resource != null && resource.data.participants != null && 
          request.auth.uid in resource.data.participants) || 
         (request.resource != null && request.resource.data.participants != null && 
          request.auth.uid in request.resource.data.participants));
    }
    
    // --- Friend Invitations ---
    match /friendInvitations/{invitationId} {
      allow create: if request.auth != null && 
        request.resource.data.fromUserId == request.auth.uid;
      allow read, update: if request.auth != null && 
        (resource.data.fromUserId == request.auth.uid || 
         resource.data.toUserId == request.auth.uid);
      allow delete: if request.auth != null && 
        resource.data.fromUserId == request.auth.uid;
    }
    
    // --- Public Profiles ---
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // --- System Data (Read-Only) ---
    match /systemData/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // --- Development/Testing ---
    match /test/{document=**} {
      allow read, write: if request.auth != null && 
        request.auth.token.email != null && 
        request.auth.token.email.matches('.*@more-human\\.co\\.uk');
    }
    
    // --- Admin (Server-Only) ---
    match /admin/{document=**} {
      allow read, write: if false;
    }
    
    // --- Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}