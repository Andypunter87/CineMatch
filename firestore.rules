rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Core User Data Protection ---
    // Users can only access their own data under their user ID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User preferences - only the user can access
      match /preferences/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's onboarding ratings - only the user can access
      match /onboardingRatings/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's recommendation feedback - only the user can access
      match /recommendationFeedback/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's watchlist ratings - only the user can access
      match /watchlistRatings/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's friends list - only the user can access
      match /friends/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's session data - only the user can access
      match /sessions/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Shared recommendations - user can access their own, plus invited sessions
      match /sharedRecommendations/{sessionId} {
        allow read, write: if request.auth != null && 
          (request.auth.uid == userId || // User owns the session
           (resource != null && resource.data.members != null && 
            resource.data.members.hasAny([request.auth.uid])) || // User is a member
           (request.resource != null && request.resource.data.members != null && 
            request.resource.data.members.hasAny([request.auth.uid]))); // User being added as member
      }
    }
    
    // --- Friend Invitations ---
    // Allow users to create friend invitations for others (by email lookup)
    match /friendInvitations/{invitationId} {
      allow create: if request.auth != null && 
        request.resource.data.fromUserId == request.auth.uid;
      allow read, update: if request.auth != null && 
        (resource.data.fromUserId == request.auth.uid || 
         resource.data.toUserId == request.auth.uid);
      allow delete: if request.auth != null && 
        resource.data.fromUserId == request.auth.uid;
    }
    
    // --- Public User Profiles (limited data) ---
    // Allow reading basic profile info for friend connections
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // --- System Data (read-only) ---
    // Allow reading system-wide data like film catalogs, streaming services
    match /systemData/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only server can write system data
    }
    
    // --- Legacy Collections (gradually being phased out) ---
    // Support for old data structure during migration
    match /user_preferences/{documentId} {
      allow read, write: if request.auth != null && 
        documentId.matches('user-.*') && 
        documentId.split('user-')[1] == request.auth.uid;
    }
    
    match /onboarding_ratings/{documentId} {
      allow read, write: if request.auth != null && 
        ((resource != null && resource.data.userId == request.auth.uid) || 
         (request.resource != null && request.resource.data.userId == request.auth.uid));
    }
    
    match /recommendation_ratings/{documentId} {
      allow read, write: if request.auth != null && 
        ((resource != null && resource.data.userId == request.auth.uid) || 
         (request.resource != null && request.resource.data.userId == request.auth.uid));
    }
    
    match /watchlist/{documentId} {
      allow read, write: if request.auth != null && 
        ((resource != null && resource.data.userId == request.auth.uid) || 
         (request.resource != null && request.resource.data.userId == request.auth.uid));
    }
    
    // --- Admin Access (server-side only) ---
    // Admin operations should use server-side Firebase Admin SDK
    match /admin/{document=**} {
      allow read, write: if false; // No client access to admin data
    }
    
    // --- Development/Testing ---
    // Test collections for development (remove in production)
    match /test/{document=**} {
      allow read, write: if request.auth != null && 
        request.auth.token.email != null && 
        request.auth.token.email.matches('.*@more-human\\.co\\.uk');
    }
    
    // --- Default Deny ---
    // Explicitly deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}